{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scienceatrisk-mirror",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server \"$PORT\" --directory scienceatrisk.org/scienceatrisk.org"
      ],
      "port": 8123,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook"],
      "port": 6006
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    }
  ]
}

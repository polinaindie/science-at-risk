diff --git a/public/css/satr-text.css b/public/css/satr-text.css
index 710d1a8..8ad8b1f 100644
--- a/public/css/satr-text.css
+++ b/public/css/satr-text.css
@@ -129,3 +129,190 @@ button, input, select, textarea { font-family: inherit; }
   :is(.scientific-societies__link, .scientific-societies .content a, .hero__list-link, .hover--underline):not(.satr-chrome *):not(#_) { font-size: max(14px, 0.7778rem); }
 }
 .scientific-societies { overflow-wrap: anywhere; }
+
+/* Running text grows with the screen: 18px on a phone, 20px at ~1130px, and it stops at 23px (the size at 1440px): a wider screen gets more margin, not bigger type. The line
+   stays 52 characters (about ten words) because its width is counted in the same unit, so the column widens with the type. */
+:root { --satr-read: clamp(18px, calc(1vw + 8.5px), 23px); --satr-measure: 100%; }
+/* The width of the article text: 65% of the screen from a tablet up (never wider than its column); the whole column on a phone. */
+@media (min-width: 768px) { :root { --satr-measure: min(65vw, 100%); } }
+
+/* One body size for running text across the site: 20px on desktop, 18px on a phone (was 18px / 16px and different per page).
+   Only long-form text is here; card captions, labels and controls keep their own sizes. */
+:is(.paragraph, .story-lead, .paper-lead, .main-text, .expertParagraph, .expertParagraph--lead,
+    .infrastructure__text, .infrastructure__sec-text, .paper__section-text):not(#_) {
+  font-size: var(--satr-read); line-height: 1.55;
+}
+
+/* A line of running text holds no more than ten words: in this mono at 20px, 52 characters (about 8-10 words). */
+:is(.paragraph, .story-lead, .paper-lead, .main-text, .expertParagraph, .expertParagraph--lead,
+    .infrastructure__text, .infrastructure__sec-text, .paper__section-text):not(#_) {
+  max-width: var(--satr-measure);
+}
+
+/* The second text style: a short note set apart from the running text — a disclaimer, a credit line, a footnote.
+   Smaller (16px), italic, in the muted ink, the same measure as the body. Use `.satr-note` in new markup; on the
+   mirrored pages the italic closing line of a story ("The reportage is published with the support of…") and the
+   footnotes are picked up below. */
+:is(.satr-note, .paragraph:has(> i:only-child), .footnotes li):not(#_) {
+  font-family: var(--font-text);
+  font-size: calc(var(--satr-read) * 0.8); line-height: 1.5; font-style: italic;
+  color: var(--color-text-muted, #4d4d4d);
+  max-width: var(--satr-measure);
+}
+
+/* ---- Article type (stories, research): the opening, the quote, the lists. Headings are set in pages/story-text.css. ---- */
+/* The opening: a large sentence or two on what the piece is about, before the running text. */
+p.story-lead:not(#_) {
+  margin: 0 0 2rem; max-width: var(--satr-measure); /* the width of a paragraph below it: 52 characters of the body */
+  font-family: var(--font-heading); font-weight: 400; letter-spacing: 0; /* the face of the quote */
+  font-size: calc(var(--satr-read) * 1.5); line-height: 1.35;
+}
+
+/* The quote: a pull quote in the heading face, with the bar the pages already have. */
+.story .quote:not(#_) { margin: 2.5rem 0; padding-left: 1.5rem; max-width: 36em; }
+.story .quote .quote__name:not(#_) {
+  font-family: var(--font-heading); font-weight: 400; font-size: calc(var(--satr-read) * 1.5); line-height: 1.35; letter-spacing: 0;
+}
+.story .quote .quote__position:not(#_) { font-size: 16px; line-height: 1.5; color: var(--color-text-muted, #4d4d4d); }
+
+/* Lists: running-text size, a marker that reads in black, the same measure as a paragraph. */
+.story .col-md-9 :is(ul, ol):not(.footnotes):not(.link__wrap):not(#_) {
+  margin: 0 0 1.25rem; padding-left: 1.75rem; max-width: var(--satr-measure);
+  font-family: var(--font-text); font-size: var(--satr-read); line-height: 1.55;
+}
+.story .col-md-9 ul:not(.footnotes):not(.link__wrap):not(#_) { list-style: disc; }
+.story .col-md-9 ol:not(.footnotes):not(#_) { list-style: decimal; }
+.story .col-md-9 :is(ul, ol):not(.footnotes):not(.link__wrap) li:not(#_) { margin: 0 0 0.5rem; padding-left: 0.25rem; }
+.story .col-md-9 :is(ul, ol):not(.footnotes):not(.link__wrap) li::marker { font-family: var(--font-ui); color: var(--color-black, #000); }
+
+/* A numbered list is indented from the text column (a tab, 3rem), the numbers hang in that indent and wrapped lines align with the first. */
+.story .col-md-9 ol:not(.footnotes):not(.link__wrap):not(#_):not(#__) { padding-left: 3rem; max-width: var(--satr-measure); }
+.story .col-md-9 ol:not(.footnotes) li:not(#_) { padding-left: 0; }
+
+/* The credits beside a story (Author, Photographer) are set like the side block of a society page: a small muted label,
+   the value under it at running-text size in black. */
+.storyAside .storyAside__title:not(#_) {
+  margin: 0 0 0.222rem;
+  font-family: var(--font-ui); font-size: 0.8333rem; font-weight: 400; line-height: 1.5; letter-spacing: 0;
+  color: var(--color-grey-700, #4d4d4d);
+}
+.storyAside .storyAside__text:not(#_) {
+  margin: 0 0 0.444rem; max-width: none; overflow-wrap: break-word;
+  font-size: 1.111rem; line-height: 1.5; color: var(--color-black, #000);
+}
+.storyAside .storyAside__text-wrap:not(#_) { margin-bottom: 1.778rem; }
+
+/* The date stands on the line of the story's type, after a dot: "Stories · 12.08.26", then the title below. The markup keeps
+   its order (type, title, date); the header column is a wrapping flex row and the title takes a line of its own. */
+.story .col-md-9:has(> .story__main-title):not(#_) { display: flex; flex-wrap: wrap; align-items: baseline; }
+.story .col-md-9 > .story__type:not(#_) { order: 1; margin-bottom: 1rem; }
+.story .col-md-9 > .story__main-title:not(#_) { order: 3; flex: 0 0 100%; margin-bottom: 2rem; }
+.story .col-md-9 > .story__main-title ~ .data:not(#_) { order: 2; margin: 0 0 1rem; }
+.story .col-md-9 > .story__main-title ~ .data::before { content: "\00b7"; margin: 0 0.6em; color: var(--color-black, #000); }
+
+/* ---- The top of a story: the page is the header's own height below the bar, the picture is a band, not a wall ---- */
+/* The original reserved 125px under a fixed header; the bar here is 68px tall, so that left a 57px hole above the breadcrumbs: now the bar's 68px plus 1.5rem. */
+.story.indentHeader:not(#_) { padding-top: calc(68px + 1.5rem) !important; }
+.story .breadcrumbs:not(#_) { margin-bottom: 1rem; }
+/* The cover was 46% of the screen width tall (520px at 1130, 880px at 1920): the title was below the fold. It is now the width of the
+   content, 12:5 and never above 460px, cropped to fill, so the title and the opening show on a big screen too. */
+.full-image:not(#_) { margin-left: 0; margin-right: 0; } /* the width of the content, not of the screen */
+.full-image__bg:not(#_) { padding-top: 0; aspect-ratio: 12 / 5; max-height: 460px; min-height: 200px; }
+.full-image img:not(#_) { object-fit: cover; }
+
+/* ---- Reading quality of a story (all built on --satr-read, so it follows the screen) ---- */
+/* Rhythm: a taller line for mono at reading size; the gap between paragraphs is one line of type. */
+.story :is(.paragraph, .story-lead):not(#_) { line-height: 1.65; }
+.story .col-md-9 .paragraph:not(#_) { margin-bottom: 1em; }
+.story .col-md-9 :is(ul, ol):not(.footnotes):not(.link__wrap):not(#_) { line-height: 1.65; }
+
+/* Headings keep their proportion to the text instead of staying a fixed size on a big screen. */
+.story .col-md-9 .heading--h2:not(#_) { font-size: calc(var(--satr-read) * 1.6); line-height: 1.25; margin: 2.2em 0 0.5em; max-width: 24em; }
+.story .col-md-9 .heading--h3:not(#_) { font-size: calc(var(--satr-read) * 1.25); line-height: 1.3; margin: 1.8em 0 0.5em; max-width: 28em; }
+
+/* Line breaks: no one-word last line in text, even lines in the big type. */
+.story :is(.paragraph, li, .satr-note):not(#_) { text-wrap: pretty; }
+.story :is(.story__main-title, .story-lead, .quote__name, .heading--h2, .heading--h3):not(#_) { text-wrap: balance; }
+
+/* Pictures in the text take the whole content column (wider than the 52-character text), caption under in the note size. */
+.story .col-md-9 figure.image:not(#_) { margin: 2em 0; max-width: none; }
+/* the picture box keeps its own ratio and the img fills it (absolute), so the img must keep height: 100% or it overflows onto the text */
+.story .col-md-9 figure.image img:not(#_) { display: block; width: 100%; height: 100%; object-fit: cover; }
+.story .col-md-9 figure.image figcaption:not(#_) {
+  margin-top: 0.6em; max-width: var(--satr-measure);
+  font-size: calc(var(--satr-read) * 0.8); line-height: 1.5; color: var(--color-text-muted, #4d4d4d);
+}
+.story .col-md-9 figure.image figcaption:empty { display: none; }
+
+/* Links in the text: a thin underline set off the letters, thicker on hover; visited ones keep the ink. */
+.story .col-md-9 :is(.paragraph, li) a:not(#_) {
+  color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em;
+}
+.story .col-md-9 :is(.paragraph, li) a:hover:not(#_) { text-decoration-thickness: 2px; }
+
+/* The credits stay beside a long read on a desktop. */
+@media (min-width: 768px) {
+  .story .storyAside:not(#_) { position: sticky; top: calc(68px + 1.5rem); }
+}
+
+/* ---- Footnotes: the ¹ ² ³ in the text link to the note, the note links back ---- */
+.footnote-ref { font-size: inherit; line-height: 1; }
+.story .col-md-9 .footnote-ref a:not(#_) {
+  display: inline; padding: 0 0.12em; text-decoration: none; line-height: 1; color: inherit; font-weight: 700;
+}
+.story .col-md-9 .footnote-ref a:hover:not(#_), .story .col-md-9 .footnote-ref a:focus-visible:not(#_) { background: var(--color-yellow, #ffd800); }
+/* the page has a bar on top: the target must not hide under it */
+:is(.footnotes li, .footnote-ref a)[id] { scroll-margin-top: calc(68px + 2rem); }
+.footnotes li:target:not(#_) { background: var(--color-yellow, #ffd800); }
+.footnotes .footnote-back:not(#_) { margin-left: 0.4em; text-decoration: none; font-style: normal; color: inherit; }
+.footnotes .footnote-back:hover:not(#_) { text-decoration: underline; }
+
+/* ---- Article entities: a picture with a caption, a gallery, a video. Same classes as the hand-off spec (handoff/prose.html):
+   .figure, .gallery, .embed. Pictures and video use the whole content column; their captions use the note size and measure. ---- */
+.story .col-md-9 :is(.figure, .embed):not(#_) { margin: 2em 0; }
+.story .col-md-9 .figure__img:not(#_) { display: block; width: 100%; height: auto; }
+.story .col-md-9 :is(.figure__caption, .embed__fallback):not(#_) {
+  margin: 0.6em 0 0; max-width: var(--satr-measure);
+  font-size: calc(var(--satr-read) * 0.8); line-height: 1.5; color: var(--color-text-muted, #4d4d4d);
+}
+.story .col-md-9 .figure__caption:empty { display: none; }
+
+/* Gallery: the one the infrastructure pages use (Swiper, started by js/client.bundle.js; js/infrastructure-page.js adds the caption from
+   the picture's alt text and writes the counter as "1 / 4"). In an article it takes the whole content column, without the side
+   indent the infrastructure page gives it next to its text. */
+.story .col-md-9 .infrastructure__slider-wrap:not(#_) { margin: 2em 0; padding-left: 0; }
+.story .col-md-9 .infrastructure__navigation:not(#_) { font-family: var(--font-ui); font-size: calc(var(--satr-read) * 0.8); }
+.story .col-md-9 .infra-caption:not(#_) {
+  margin: 0.6em 0 0; max-width: var(--satr-measure);
+  font-size: calc(var(--satr-read) * 0.8); line-height: 1.5; color: var(--color-text-muted, #4d4d4d);
+}
+.story .col-md-9 .infra-caption:empty { display: none; }
+
+/* Video: a 16:9 frame. A third-party video loads only after the visitor presses play (the poster carries the notice and the
+   button); without script the button is a plain link to the video. A self-hosted file goes in the same frame as <video controls>. */
+.story .col-md-9 .embed__frame:not(#_) { position: relative; aspect-ratio: 16 / 9; background: var(--color-black, #000); color: var(--color-white, #fff); }
+.story .col-md-9 .embed__frame :is(iframe, video):not(#_) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
+.story .col-md-9 .embed__poster:not(#_) {
+  position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
+  padding: 1.5rem; text-align: center; font-family: var(--font-ui);
+}
+.story .col-md-9 .embed__consent:not(#_) { margin: 0; max-width: 34em; font-size: 16px; line-height: 1.5; color: inherit; }
+.story .col-md-9 a.embed__play:not(#_) {
+  display: inline-flex; align-items: center; min-height: 44px; padding: 0.5rem 1.5rem; border: 2px solid var(--color-white, #fff);
+  background: var(--color-white, #fff); color: var(--color-black, #000); font: inherit; text-decoration: none; cursor: pointer;
+}
+.story .col-md-9 a.embed__play:hover:not(#_) { background: var(--color-blue, #b8d8ff); }
+.story .col-md-9 a.embed__play:focus-visible:not(#_) { outline: 3px solid var(--color-white, #fff); outline-offset: 3px; }
+.story .col-md-9 .embed__fallback a:not(#_) { color: inherit; }
+
+/* The ¹ ² ³ are already superscript characters: the <sup> must not raise them a second time. */
+.story .col-md-9 sup.footnote-ref:not(#_) { vertical-align: baseline; }
+
+/* The tag over a story is set in the size of the date beside it (15px, same line), so the pair reads as one line. */
+.story .col-md-9 > .story__type:not(#_), .story .col-md-9 > .story__main-title ~ .data:not(#_) {
+  font-size: 0.8333rem; line-height: 1.5; letter-spacing: 0;
+}
+
+/* Pictures, the gallery and the video are exactly as wide as the text above and below them. */
+.story .col-md-9 :is(figure.image, .figure, .infrastructure__slider-wrap, .embed):not(#_):not(#__) { max-width: var(--satr-measure); }
+.story .col-md-9 .gallery .figure:not(#_):not(#__) { max-width: none; }
